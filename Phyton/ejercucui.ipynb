   "source": [
    "def frecuencias_letras(texto):\n",
    "    frecuencias = {}\n",
    "    \n",
    "    for letra in texto.lower():\n",
    "        if letra.isalpha():\n",
    "            frecuencias[letra] = frecuencias.get(letra, 0) + 1\n",
    "    \n",
    "    return frecuencias"
   ]
